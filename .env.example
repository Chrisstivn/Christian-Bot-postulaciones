# Copy this file to .env and enter your own credentials locally.
# Do not commit .env or backup copies.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-2.5-flash

# Replace with Christian's own CV after adapting the template.
CV_MAESTRO_DOCX=Christian_CV.docx
SUBMIT_APPLICATIONS=false
OUTPUT_EXCEL_PATH=data/postulaciones.xlsx

# Local database settings: use your own passwords and connection string.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
POSTGRES_USER=jobbot
POSTGRES_DB=jobqueue
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_PASSWORD=
JOBQUEUE_DSN=

# Exact latest-role values, populated from the new CV.
CV_CURRENT_COMPANY=
CV_CURRENT_DATES=
APPLICANT_FIRST_NAME=
APPLICANT_LAST_NAME=
APPLICANT_EMAIL=
APPLICANT_PHONE=
APPLICANT_LINKEDIN=
APPLICANT_LOCATION=
APPLICANT_AVAILABLE_FROM=
