        "jsCode": "const outputs = [];\nfor (const item of $input.all()) {\n  const urls = Array.isArray(item.json.new_job_urls) ? item.json.new_job_urls : [];\n  for (const u of urls) {\n    const url = String(u || '').trim();\n    if (url) outputs.push({ json: { url, empty_batch: false } });\n  }\n}\nif (outputs.length === 0) {\n  return [{ json: { empty_batch: true } }];\n}\nreturn outputs;"
