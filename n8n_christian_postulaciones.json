        "jsCode": "const staticData = $getWorkflowStaticData('global');\nconst THREE_HOURS_MS = 3 * 60 * 60 * 1000;\nconst now = Date.now();\nconst last = staticData.lastLinkedInScrapeAt || 0;\nconst shouldRun = (now - last) >= THREE_HOURS_MS;\nif (shouldRun) {\n  staticData.lastLinkedInScrapeAt = now;\n}\nreturn [{ json: { should_scrape_linkedin: shouldRun, minutes_since_last: Math.round((now - last) / 60000) } }];"
      },
