      "parameters": {
        "jsCode": "return $input.all().filter(item => {\n  const status = String(item.json.Status || '').trim().toUpperCase();\n  const link = String(item.json.Link || '').trim();\n  return ['NEW', 'READY'].includes(status) && link.includes('linkedin.com/jobs/');\n});"
      },
