{
  "name": "Maintenance - Recheck LinkedIn Applications",
  "nodes": [
    {
      "parameters": {},
      "id": "3ee964bb-2f22-4a57-b33d-001-checkjobs",
      "name": "Manual Trigger - Recheck LinkedIn",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        -720,
        0
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://host.docker.internal:8000/excel-output/rows",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "3ee964bb-2f22-4a57-b33d-002-checkjobs",
      "name": "Get Jobs from Sheet",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -480,
        0
      ],
      "notes": "Excel local del proyecto: data/postulaciones.xlsx. Sin conexión a Google Sheets."
    },
    {
      "parameters": {
        "jsCode": "return $input.all().filter(item => {\n  const status = String(item.json.Status || '').trim().toUpperCase();\n  const link = String(item.json.Link || '').trim();\n  return ['NEW', 'READY'].includes(status) && link.includes('linkedin.com/jobs/');\n});"
      },
      "id": "3ee964bb-2f22-4a57-b33d-003-checkjobs",
      "name": "Only NEW or READY LinkedIn Jobs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -240,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8000/check-linkedin-job-status",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { url: $json.Link } }}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "3ee964bb-2f22-4a57-b33d-004-checkjobs",
      "name": "Check If Application Is Closed",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 1
          },
          "conditions": [
            {
              "id": "closed-status-condition",
              "leftValue": "={{ $json.status }}",
              "rightValue": "closed",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "3ee964bb-2f22-4a57-b33d-005-checkjobs",
      "name": "Only Closed",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8000/excel-output/rows",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { row: {\"Link\": ($json.url), \"Status\": (\"CLOSED\"), \"reason\": ('LinkedIn: ' + ($json.reason || 'no longer accepting applications'))}, matching_columns: [\"Link\"], preserve_existing: false } }}"
      },
      "id": "3ee964bb-2f22-4a57-b33d-006-checkjobs",
      "name": "Mark CLOSED in Sheet",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
