    {
      "parameters": {
        "jsCode": "function canon(value) {\n  const raw = String(value || '').trim();\n  if (!raw) return '';\n  try {\n    const u = new URL(raw);\n    u.hash = '';\n    u.search = '';\n    const path = u.pathname.replace(/\\/+$/, '');\n    return (u.origin + path).toLowerCase();\n  } catch {\n    return raw.replace(/[?#].*$/, '').replace(/\\/+$/, '').toLowerCase();\n  }\n}\n\nconst existing = new Set();\nfor (const item of $input.all()) {\n  for (const value of [item.json.Link, item.json.real_apply_url]) {\n    const normalized = canon(value);\n    if (normalized) existing.add(normalized);\n  }\n}\nreturn [{ json: { existing_links: [...existing] } }];"
      },
      "id": "4c646d0b-446a-4bc9-a6ce-3cc48df1a102",
      "name": "Build Existing Link Set1",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1264,
        -2192
      ],
      "notes": "Collapse Sheet rows to one existing_links list so Search Params executes once."
    },
    {
      "parameters": {
        "jsCode": "function canon(value) {\n  const raw = String(value || '').trim();\n  if (!raw) return '';\n  try {\n    const u = new URL(raw);\n    u.hash = '';\n    u.search = '';\n    const path = u.pathname.replace(/\\/+$/, '');\n    return (u.origin + path).toLowerCase();\n  } catch {\n    return raw.replace(/[?#].*$/, '').replace(/\\/+$/, '').toLowerCase();\n  }\n}\n\nconst existing = new Set(\n  ($(\"Build Existing Link Set1\").first().json.existing_links || [])\n    .map(canon)\n    .filter(Boolean)\n);\n\nreturn $input.all().filter(item => {\n  const link = canon(item.json.url || item.json.job_url || item.json.Link);\n  return link && !existing.has(link);\n});"
      },
